/* global TrelloPowerUp */

const ICON_URL = 'https://example.com/print-icon.png'; // Replace with your icon URL

window.TrelloPowerUp.initialize({
  'card-buttons': function(t) {
    return [{
      icon: ICON_URL,
      text: 'Print Card',
      callback: function(t) {
        return t.card('id', 'name', 'desc', 'labels', 'members', 'due', 'attachments')
          .then(card => Promise.all([
            t.board('name'),
            t.list('name'),
            t.getChecklists(card.id),
            t.get('card', 'shared', 'customFields'), // Requires Custom Fields Power-Up
            t.getComments(card.id) // Requires API call via backend
          ]).then(([board, list, checklists, customFields, comments]) => {
            
            // Build selection popup
            const items = [
              { text: 'Board Name', callback: () => printOptions.boardName = board.name },
              { text: 'List Name', callback: () => printOptions.listName = list.name },
              { text: 'Card Number', callback: () => printOptions.cardNumber = card.idShort },
              { text: 'Title', callback: () => printOptions.title = card.name },
              { text: 'Labels', callback: () => printOptions.labels = card.labels },
              { text: 'Members', callback: () => printOptions.members = card.members },
              { text: 'Due Date', callback: () => printOptions.due = card.due },
              { text: 'Description', callback: () => printOptions.description = card.desc },
              { text: 'Custom Fields', callback: () => printOptions.customFields = customFields },
              { text: 'Attachments', callback: () => printOptions.attachments = card.attachments },
              { text: 'Comments', callback: () => printOptions.comments = comments },
              ...checklists.map(cl => ({
                text: `Checklist: ${cl.name}`,
                callback: () => {
                  if (!printOptions.checklists) printOptions.checklists = [];
                  printOptions.checklists.push(cl);
                }
              }))
            ];

            return t.popup({
              title: 'Select Items to Print',
              items: items,
              search: false
            }).then(() => {
              generatePrintHTML(printOptions);
            });
          }));
      }
    }];
  }
});

